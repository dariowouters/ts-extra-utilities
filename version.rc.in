#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PLUGIN_VERSION_MAJOR@, @PLUGIN_VERSION_MINOR@, @PLUGIN_VERSION_PATCH@, 0
PRODUCTVERSION @PLUGIN_TARGET_VERSION_MAJOR@, @PLUGIN_TARGET_VERSION_MINOR@, 0, 0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Dario Wouters"
      VALUE "FileDescription", "TS Extra Utilities Plugin for ETS2/ATS"
      VALUE "FileVersion", "@PLUGIN_VERSION_MAJOR@.@PLUGIN_VERSION_MINOR@.@PLUGIN_VERSION_PATCH@"
      VALUE "InternalName", "ts-extra-utilities.dll"
      VALUE "LegalCopyright", "Copyright (c) 2025 Dario Wouters"
      VALUE "OriginalFilename", "ts-extra-utilities.dll"
      VALUE "ProductName", "TS Extra Utilities"
      VALUE "ProductVersion", "@PLUGIN_TARGET_VERSION_MAJOR@.@PLUGIN_TARGET_VERSION_MINOR@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
